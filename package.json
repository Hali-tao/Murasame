{
  "name": "murasame-desktop",
  "version": "0.9.0",
  "private": true,
  "description": "Murasame Windows desktop companion - Electron product shell",
  "author": "Murasame",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "inspect:pet": "npm run build && node scripts/inspect-pet.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:perception": "node scripts/verify-perception.mjs",
    "verify:isolation": "node scripts/verify-isolation-live.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "trace": "node scripts/traceability.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run trace",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@pixi/unsafe-eval": "^6.5.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.60.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
